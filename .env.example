# Copy this file to .env.local for local development, and set the same keys in
# the Netlify UI (Site settings → Environment variables) for production.
# Never commit real values.

# Kit (formerly ConvertKit) v4 API key. Used server-side only by
# netlify/functions/subscribe.ts, which sends it as the "X-Kit-Api-Key" header
# to https://api.kit.com/v4. Create/find it in Kit under
# Settings → Developer → API keys ("V4 API key"). This value is secret and must
# never be exposed to the browser (note: it is NOT prefixed with NEXT_PUBLIC_).
KIT_API_KEY=

# The numeric ID of the Kit form new subscribers are added to. For this project
# the "Where Did My Money Go? — Tracker Signup" form has ID 9746847. You can
# also list forms in Kit (Grow → Landing Pages & Forms) to confirm the ID.
KIT_FORM_ID=

# OPTIONAL. The numeric ID of the Kit tag applied to each new subscriber so a
# Kit automation can trigger on it. For this project the "budgetcraft-leadmagnet"
# tag has ID 21712788. When this is unset, subscribe.ts skips tag application
# entirely (signups still work); tag application is non-blocking either way.
KIT_TAG_ID=

# The canonical, publicly reachable base URL of the site, with no trailing
# slash. Used for canonical tags, Open Graph URLs, the sitemap, and JSON-LD.
# Example: https://budgetcraftstudio.com
# This one IS exposed to the browser (NEXT_PUBLIC_ prefix), which is fine —
# it is only the public site URL.
NEXT_PUBLIC_SITE_URL=
